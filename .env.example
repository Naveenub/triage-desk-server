# Copy to .env and load it however you run the server (for example: node --env-file=.env server.js)
ANTHROPIC_API_KEY=
PORT=3000
DB_PATH=./data/triage.db
NODE_ENV=production
COOKIE_SECURE=true            # needs HTTPS; set false only for local http testing
TRUST_PROXY=false             # true if you run behind a reverse proxy (so rate limits see real IPs)
SIGNUP_ENABLED=true           # false once you want invite-only (admins add teammates; you add new orgs by hand)
DEFAULT_PLAN=trial

# Models per tier. Defaults: quick=claude-haiku-5-5, default=claude-sonnet-5-5, complex=claude-opus-5-5
# MODEL_QUICK=
# MODEL_DEFAULT=
# MODEL_COMPLEX=

# Hard stop on total AI tokens per calendar month across ALL customers (0 or unset = off)
GLOBAL_MONTHLY_TOKEN_CAP=0

# Optional. USD per million tokens, copied from the current price list, to turn tokens into cost:
# PRICES_JSON={"claude-haiku-5-5":{"in":0,"out":0},"claude-sonnet-5-5":{"in":0,"out":0}}

# Optional. Override or add plans. aiTokens = tokens per month, maxTier = quick|default|complex
# PLANS_JSON={"team":{"aiTokens":3000000,"maxTier":"complex","maxImages":4,"rpm":60}}
