# Copy to .env and load it however you run the server (for example: node --env-file=.env server.js)
ANTHROPIC_API_KEY=
PORT=3000
DB_PATH=./data/triage.db
NODE_ENV=production
COOKIE_SECURE=true            # needs HTTPS; set false only for local http testing
TRUST_PROXY=false             # true if you run behind a reverse proxy (so rate limits see real IPs)
SIGNUP_ENABLED=true           # false once you want invite-only (admins add teammates; you add new orgs by hand)
DEFAULT_PLAN=trial

# Email: password reset and address verification. Leave EMAIL_PROVIDER unset to run without email.
# With email on, AI analysis needs a confirmed address (this stops throwaway sign-ups spending tokens).
EMAIL_PROVIDER=             # resend | postmark | log   (log prints emails to the console: development only)
EMAIL_FROM=                 # e.g. Triage Desk <no-reply@yourdomain.com>. The domain must be verified with the provider.
APP_URL=                    # public https address of this server, no trailing slash. Used for links in emails.
RESEND_API_KEY=             # when EMAIL_PROVIDER=resend
POSTMARK_SERVER_TOKEN=      # when EMAIL_PROVIDER=postmark
# VERIFY_TOKEN_HOURS=24
# RESET_TOKEN_MINUTES=60
# SIGNUPS_PER_HOUR_PER_IP=5
# RESET_REQUESTS_PER_HOUR_PER_IP=10

# Models per tier. Defaults: quick=claude-haiku-5-5, default=claude-sonnet-5-5, complex=claude-opus-5-5
# MODEL_QUICK=
# MODEL_DEFAULT=
# MODEL_COMPLEX=

# Stripe billing (optional, all four together). Plan prices live in Stripe; we only need the price ids.
# Dashboard: create a recurring Price per paid plan, enable the Customer portal (Settings > Billing > Customer portal),
# and add a webhook endpoint at https://YOUR-APP-URL/api/stripe/webhook with events:
#   checkout.session.completed, customer.subscription.created, customer.subscription.updated, customer.subscription.deleted
STRIPE_SECRET_KEY=          # sk_live_... (or sk_test_... while testing)
STRIPE_WEBHOOK_SECRET=      # whsec_... shown on the webhook endpoint
STRIPE_PRICE_TEAM=          # price_... for the "team" plan. For several plans use STRIPE_PRICES_JSON={"team":"price_...","pro":"price_..."}
# BILLING_DOWNGRADE_PLAN=free   # plan an org falls back to when its subscription ends

# Backups of the SQLite file (see README). Built-in schedule: set BACKUP_EVERY_HOURS=24. 0 = off, use cron instead.
# BACKUP_DIR=./backups
# BACKUP_KEEP=14
# BACKUP_EVERY_HOURS=24

# Hard stop on total AI tokens per calendar month across ALL customers (0 or unset = off)
GLOBAL_MONTHLY_TOKEN_CAP=0

# Optional. USD per million tokens, copied from the current price list, to turn tokens into cost:
# PRICES_JSON={"claude-haiku-5-5":{"in":0,"out":0},"claude-sonnet-5-5":{"in":0,"out":0}}

# Optional. Override or add plans. aiTokens = tokens per month, maxTier = quick|default|complex
# PLANS_JSON={"team":{"aiTokens":3000000,"maxTier":"complex","maxImages":4,"rpm":60}}
